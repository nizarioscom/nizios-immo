// Schéma multi-tenant du Pack Présence Digitale Immo.
// Toute table métier porte tenantId, sauf Tenant lui-même.
// User.tenantId est null uniquement pour le super-admin Nizios
// (contrainte SQL dans la migration initiale).
//
// RLS (FORCE) sur Property, PropertyPhoto et Lead : voir la migration.
// User et Tenant ne sont pas sous RLS : la connexion se fait par e-mail,
// et la résolution publique se fait par domaine.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Tenant {
  id              String   @id @default(uuid()) @db.Uuid
  slug            String   @unique
  name            String
  domains         String[]
  defaultLocale   String   @default("fr")
  locales         String[] @default(["fr", "ar"])
  branding        Json
  whatsappNumbers String[]
  /// Réglages internes (pack, ville, statut). Pas le contenu éditorial.
  config          Json     @default("{}")
  /// Textes FR/AR copiés depuis clients/<slug>/content au moment du seed.
  content         Json     @default("{}")
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  users      User[]
  properties Property[]
  leads      Lead[]
}

enum UserRole {
  SUPER_ADMIN
  AGENCY_ADMIN
}

model User {
  id           String   @id @default(uuid()) @db.Uuid
  email        String   @unique
  passwordHash String
  name         String
  role         UserRole
  tenantId     String?  @db.Uuid
  tenant       Tenant?  @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@index([tenantId])
}

/// Publié / dépublié. Pas d'endpoint HTTP au Jour 1.
enum PropertyStatus {
  PUBLISHED
  UNPUBLISHED
}

enum TransactionType {
  BUY
  RENT
}

model Property {
  id           String           @id @default(uuid()) @db.Uuid
  tenantId     String           @db.Uuid
  tenant       Tenant           @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  title        String
  description  String?          @db.Text
  status       PropertyStatus   @default(UNPUBLISHED)
  priceMad     Int?
  neighborhood String?
  transaction  TransactionType?
  photos       PropertyPhoto[]
  createdAt    DateTime         @default(now())
  updatedAt    DateTime         @updatedAt

  @@unique([id, tenantId])
  @@index([tenantId])
  @@index([tenantId, status])
}

model PropertyPhoto {
  id         String   @id @default(uuid()) @db.Uuid
  tenantId   String   @db.Uuid
  propertyId String   @db.Uuid
  property   Property @relation(fields: [propertyId, tenantId], references: [id, tenantId], onDelete: Cascade)
  url        String
  alt        String?
  sortOrder  Int      @default(0)
  createdAt  DateTime @default(now())

  @@index([tenantId])
  @@index([propertyId])
}

enum LeadSource {
  SITE
  WHATSAPP
  CALL
  MESSENGER
}

/// Achat ou location.
enum LeadIntent {
  BUY
  RENT
}

/// Nouveau → Qualifié → Appelé → Visite → Deal / Perdu.
enum LeadStatus {
  NEW
  QUALIFIED
  CALLED
  VISIT
  DEAL
  LOST
}

model Lead {
  id           String      @id @default(uuid()) @db.Uuid
  tenantId     String      @db.Uuid
  tenant       Tenant      @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  source       LeadSource
  name         String
  phone        String
  intent       LeadIntent?
  budgetMad    Int?
  neighborhood String?
  timeline     String?
  status       LeadStatus  @default(NEW)
  notes        String?     @db.Text
  reminderAt   DateTime?
  createdAt    DateTime    @default(now())
  updatedAt    DateTime    @updatedAt

  @@index([tenantId])
  @@index([tenantId, status])
}
