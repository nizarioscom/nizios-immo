{
  "name": "@nizios/chatbot-flows",
  "version": "0.0.0",
  "private": true,
  "description": "Flux JSON versionnés du chatbot qualificateur Darija/FR.",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.json && mkdir -p dist/flows && cp src/flows/default.json dist/flows/default.json",
    "dev": "tsc -p tsconfig.json --watch",
    "lint": "eslint src test --max-warnings 0",
    "test": "tsx --test test/*.test.ts"
  },
  "devDependencies": {
    "@types/node": "22.15.21",
    "@typescript-eslint/eslint-plugin": "7.18.0",
    "@typescript-eslint/parser": "7.18.0",
    "eslint": "8.57.1",
    "tsx": "4.19.3",
    "typescript": "5.6.3"
  }
}
