# Copier vers .env à la racine. Valeurs de développement uniquement — aucun secret réel.

DATABASE_URL=postgresql://nizios:nizios@localhost:5432/nizios

JWT_SECRET=dev-only-not-a-secret
JWT_EXPIRES_IN=12h

API_PORT=3001
WEB_ORIGIN=http://localhost:3000,http://localhost:3002

# Le navigateur parle au site Next (même origine). Le serveur Next appelle l'API.
# En Docker Compose, API_URL_INTERNAL est surchargé par http://api:3001.
API_URL_INTERNAL=http://localhost:3001
NEXT_PUBLIC_API_URL=http://localhost:3001
# COOKIE_SECURE=true

# Optionnel. La source de vérité des domaines est clients/<slug>/tenant.config.json.
# Cette carte ne sert qu'aux hôtes qui ne suivent pas <slug>.localhost ni <slug>.nizarios.fr.
TENANT_HOST_MAP={"localhost":"elhilal","127.0.0.1":"elhilal"}

# Mots de passe DÉMO locaux, à changer avant tout usage réel.
SEED_ADMIN_PASSWORD=demo-elhilal-2026
NIZIOS_SUPERADMIN_EMAIL=admin@nizios.example
NIZIOS_SUPERADMIN_PASSWORD=demo-nizios-2026
NIZIOS_SUPERADMIN_NAME="Admin Nizios"

# WhatsApp Cloud API (Meta). Laisser vide en local : la notification part en lien wa.me.
# Aucun jeton réel dans ce fichier.
WHATSAPP_CLOUD_TOKEN=
WHATSAPP_CLOUD_PHONE_NUMBER_ID=
